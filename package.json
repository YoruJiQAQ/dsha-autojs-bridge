{
  "name": "dsha-autojs-bridge",
  "version": "0.1.0",
  "description": "DSHA ↔ Auto.js Pro bridge: click/read nodes in apps DSHA cannot see (via AutoJsPro MCP), and drive AutoJsPro remotely to run any script (via its debug RPC).",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "tools",
    "skills",
    "phone",
    "docs",
    "install.sh",
    "README.md",
    "README.en.md",
    "LICENSE",
    "cordis.patch.yml",
    "package.json"
  ],
  "keywords": [
    "accessibility",
    "android",
    "autojs",
    "autojspro",
    "automation",
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "dsh-plugin",
    "dsha",
    "dsha-plugin",
    "skill",
    "wechat"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YoruJiQAQ/dsha-autojs-bridge.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "author": "YoruJiQAQ",
  "homepage": "https://github.com/YoruJiQAQ/dsha-autojs-bridge#readme",
  "bugs": {
    "url": "https://github.com/YoruJiQAQ/dsha-autojs-bridge/issues"
  }
}
